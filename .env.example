# Copy to .env and fill each secret with the output of: openssl rand -hex 32
# APP_KEYS takes a comma separated list of keys.
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Leave unset to use SQLite in .tmp/data.db.
# DATABASE_URL=postgres://strapi:strapi@localhost:5432/strapi
